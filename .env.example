# ================================================
# VOICE AUTOMATION PLATFORM v3.0
# Environment Configuration
# Author: iluminat1scode
# ================================================

# === TWILIO CONFIGURATION ===
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_EDGE=sydney
TWILIO_REGION=au1
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Additional Twilio Numbers (for load balancing)
TWILIO_PHONE_NUMBERS=+1234567890,+1234567891,+1234567892
TWILIO_WEBHOOK_VALIDATION=true
TWILIO_STATUS_CALLBACK_URL=https://api.voiceplatform.com/webhooks/status
TWILIO_VOICE_URL=https://api.voiceplatform.com/voice

# === DATABASE CONFIGURATION ===
# MongoDB Cluster
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/voice-platform?retryWrites=true&w=majority
MONGODB_DB_NAME=voice-platform
MONGODB_POOL_SIZE=10
MONGODB_CONNECTION_TIMEOUT=10000
MONGODB_SOCKET_TIMEOUT=45000
MONGODB_REPLICA_SET=rs0

# Redis Cluster
REDIS_HOST=redis-cluster.amazonaws.com
REDIS_PORT=6379
REDIS_PASSWORD=supersecurepassword
REDIS_DB=0
REDIS_CLUSTER_MODE=true
REDIS_CLUSTER_NODES=redis-1:6379,redis-2:6379,redis-3:6379
REDIS_KEY_PREFIX=vap:

# Cache Redis (separate instance)
REDIS_CACHE_URL=redis://localhost:6380
REDIS_CACHE_TTL=3600

# Pub/Sub Redis
REDIS_PUB_URL=redis://localhost:6381
REDIS_SUB_URL=redis://localhost:6381

# === APPLICATION CONFIGURATION ===
NODE_ENV=production
PORT=3000
WORKERS=4
BASE_URL=https://api.voiceplatform.com
API_VERSION=v3
APP_NAME=VoiceAutomationPlatform

# === SECURITY ===
JWT_SECRET=your-super-secure-jwt-secret-key-at-least-256-bits
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-token-secret-key
JWT_REFRESH_EXPIRES_IN=30d

ENCRYPTION_KEY=your-256-bit-encryption-key-for-sensitive-data
ENCRYPTION_ALGORITHM=aes-256-gcm

API_KEY=your-main-api-key-for-external-access
API_RATE_LIMIT=100
API_RATE_WINDOW=900000

CORS_ORIGINS=https://app.voiceplatform.com,https://admin.voiceplatform.com
CORS_CREDENTIALS=true

# === MONITORING & LOGGING ===
SENTRY_DSN=https://xxxxxxxxxxxx@sentry.io/xxxxxxx
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

LOG_LEVEL=info
LOG_FILE_PATH=./logs
LOG_MAX_SIZE=10m
LOG_MAX_FILES=30
LOG_COMPRESS=true

PROMETHEUS_PORT=9090
METRICS_ENABLED=true

NEW_RELIC_LICENSE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEW_RELIC_APP_NAME=VoiceAutomationPlatform

# === PERFORMANCE ===
MAX_CONCURRENT_CALLS=10000
MAX_CALLS_PER_CAMPAIGN=5000
CALL_TIMEOUT_SECONDS=300
DEFAULT_CALL_DURATION_LIMIT=3600

QUEUE_CONCURRENCY=100
QUEUE_MAX_JOBS=10000
RETRY_ATTEMPTS=3
RETRY_DELAY=60000
RETRY_BACKOFF=exponential

RATE_LIMIT_CALLS_PER_HOUR=1000
RATE_LIMIT_CALLS_PER_MINUTE=50

# === COMPLIANCE ===
RECORDING_ENABLED=false
RECORDING_ENCRYPTION=true
RECORDING_RETENTION_DAYS=90

TRANSCRIPTION_ENABLED=false
TRANSCRIPTION_LANGUAGE=en-US

DNC_CHECK_ENABLED=true
DNC_API_URL=https://dnc-api.com/check
DNC_API_KEY=your-dnc-api-key

TCPA_COMPLIANCE=true
TCPA_TIME_ZONE_CHECK=true
TCPA_HOURS_START=9
TCPA_HOURS_END=21

GDPR_COMPLIANCE=true
GDPR_DATA_RETENTION_DAYS=365
GDPR_ANONYMIZATION_ENABLED=true

# === INTEGRATIONS ===
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx
SLACK_ALERTS_ENABLED=true
SLACK_CHANNEL=#voice-alerts

WEBHOOK_SIGNATURE_SECRET=your-webhook-signature-secret
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_TIMEOUT=10000

SALESFORCE_ENABLED=false
SALESFORCE_CLIENT_ID=your-salesforce-client-id
SALESFORCE_CLIENT_SECRET=your-salesforce-client-secret
SALESFORCE_INSTANCE_URL=https://yourinstance.salesforce.com

# === AWS SERVICES ===
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

S3_BUCKET_NAME=voice-platform-recordings
S3_REGION=us-east-1
S3_ENDPOINT=https://s3.amazonaws.com
S3_SIGNATURE_VERSION=v4

SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/xxxxxxxxxxxx/voice-queue
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:xxxxxxxxxxxx:voice-notifications

# === MACHINE LEARNING ===
ML_API_ENDPOINT=https://ml.voiceplatform.com
ML_API_KEY=your-ml-api-key
ML_SENTIMENT_ANALYSIS=true
ML_VOICE_BIOMETRICS=false
ML_CALL_PREDICTION=true

# === FEATURE FLAGS ===
FEATURE_VOICE_BIOMETRICS=false
FEATURE_REAL_TIME_TRANSCRIPTION=true
FEATURE_MULTI_LANGUAGE=true
FEATURE_AI_ROUTING=true
FEATURE_PREDICTIVE_DIALING=true
FEATURE_VOICE_MAIL_DETECTION=true
FEATURE_CALL_RECORDING=false
FEATURE_CONFERENCE_CALLS=true

# === BUSINESS HOURS ===
BUSINESS_HOURS_ENABLED=true
DEFAULT_TIMEZONE=America/New_York
WEEKEND_CALLS_ALLOWED=false
HOLIDAY_CALENDAR_URL=https://api.voiceplatform.com/holidays

# === DEVELOPMENT/DEBUG ===
DEBUG=false
DEBUG_SQL=false
DEBUG_REDIS=false
DEBUG_TWILIO=false
VERBOSE_ERRORS=false
PRETTY_LOGS=false

# === BACKUP & RECOVERY ===
BACKUP_ENABLED=true
BACKUP_INTERVAL=86400000
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=voice-platform-backups

# === CLUSTERING ===
CLUSTER_ENABLED=true
CLUSTER_WORKERS=auto
CLUSTER_KILL_TIMEOUT=5000
CLUSTER_RESTART_DELAY=1000

# === HEALTH CHECKS ===
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_RETRIES=3

# ================================================
# END OF CONFIGURATION
# ================================================
